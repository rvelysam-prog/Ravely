rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['matricule', 'nom_complet', 'poste', 'type_contrat', 'salaire']) &&
        data.matricule is string && data.matricule.size() >= 3 && data.matricule.size() <= 64 &&
        data.nom_complet is string && data.nom_complet.size() >= 1 && data.nom_complet.size() <= 200 &&
        data.poste is string && data.poste.size() >= 1 && data.poste.size() <= 200 &&
        data.type_contrat is string && data.type_contrat.size() >= 1 && data.type_contrat.size() <= 50 &&
        (data.salaire is number || data.salaire is int || data.salaire is float);
    }

    function isValidContract(data) {
      return data.keys().hasAll(['matricule', 'type_contrat']) &&
        data.matricule is string && data.matricule.size() >= 3 && data.matricule.size() <= 64 &&
        data.type_contrat is string && data.type_contrat.size() >= 1 && data.type_contrat.size() <= 50;
    }

    function isValidMail(data) {
      return data.keys().hasAll(['from', 'to', 'message']) &&
        data.from is string && data.from.size() >= 3 && data.from.size() <= 200 &&
        data.to is list && data.to.size() >= 1 && data.to.size() <= 10;
    }

    function isValidPostulantRecord(data) {
      return data.keys().hasAll(['id', 'casType', 'nomComplet']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.casType is string && data.casType.size() >= 1 && data.casType.size() <= 32 &&
        data.nomComplet is string && data.nomComplet.size() >= 1 && data.nomComplet.size() <= 200;
    }

    function isValidFichesDocEs(data) {
      return data.keys().hasAll(['referenceDossier']) &&
        data.referenceDossier is string && data.referenceDossier.size() >= 1 && data.referenceDossier.size() <= 128;
    }

    function isValidPublicDocument(data) {
      return data.keys().hasAll(['id', 'title']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300;
    }

    match /employees/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if true;
      allow create: if isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isValidId(employeeId);
    }

    match /contracts/{contractId} {
      allow get: if isValidId(contractId);
      allow list: if true;
      allow create: if isValidId(contractId) && isValidContract(incoming());
      allow update: if isValidId(contractId) && isValidContract(incoming());
      allow delete: if isValidId(contractId);
    }

    match /mail/{mailId} {
      allow get: if isValidId(mailId);
      allow list: if true;
      allow create: if isValidId(mailId) && isValidMail(incoming());
      allow update: if isValidId(mailId);
      allow delete: if isValidId(mailId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isValidId(settingId);
      allow update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }

    match /job_offers/{offerId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(offerId);
    }

    match /drafts/{draftId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(draftId);
    }

    match /custom_postes/{posteId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(posteId);
    }

    match /postulants_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create: if isValidId(recordId) && isValidPostulantRecord(incoming());
      allow update: if isValidId(recordId) && isValidPostulantRecord(incoming());
      allow delete: if isValidId(recordId);
    }

    match /postulants_fiches_doc_es/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create: if isValidId(docId) && isValidFichesDocEs(incoming());
      allow update: if isValidId(docId) && isValidFichesDocEs(incoming());
      allow delete: if isValidId(docId);
    }

    match /public_documents/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create: if isValidId(docId) && isValidPublicDocument(incoming());
      allow update: if isValidId(docId) && isValidPublicDocument(incoming());
      allow delete: if isValidId(docId);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
